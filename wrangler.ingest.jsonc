/**
 * Non-public ingest/data Worker — sole D1 authority and typed RPC surface.
 * Deploy ingest before web (Service Binding target must exist).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "filatracker-ingest",
	"compatibility_date": "2026-08-08",
	"main": "./workers/ingest.ts",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"RPC_DEADLINE_MS": "2000"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "filatracker-local",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "db/migrations"
		}
	]
}
