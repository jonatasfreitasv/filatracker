/**
 * Non-public ingest/data Worker — sole D1 authority and typed RPC surface.
 * Deploy ingest before web (Service Binding target must exist).
 * Queues + schedule live here only — never on wrangler.web.jsonc.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "filatracker-ingest",
	"compatibility_date": "2026-08-08",
	"main": "./workers/ingest.ts",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"RPC_DEADLINE_MS": "2000",
		"RECOVERY_EPOCH": "1"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "filatracker-local",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "db/migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "INGEST_QUEUE",
				"queue": "filatracker-ingest-local"
			}
		],
		"consumers": [
			{
				"queue": "filatracker-ingest-local",
				"max_retries": 3,
				"dead_letter_queue": "filatracker-ingest-dlq-local",
				"max_batch_size": 5,
				"max_batch_timeout": 5
			}
		]
	},
	"triggers": {
		"crons": ["0 */6 * * *"]
	}
}
